# Copy to .env in this folder and fill in what you have. .env is gitignored.

# TypeSafe (Jev) API key. Without it, jev_client.py falls back to a clearly
# labelled mock -- fine for testing the plumbing, but it proves nothing about
# whether Jev is actually useful. Get a real key at https://typesafe.ai before
# trusting any collected predictions.
TYPESAFE_API_KEY=

# Kalshi demo key -- not needed for anything in scripts/collect_predictions.py
# or score_predictions.py, since GET /markets is unauthenticated. Only add
# this once you move past the read-only POC.
# KALSHI_KEY_ID=
# KALSHI_KEY_PATH=kalshi_demo.pem

# The Odds API -- sign up at https://the-odds-api.com (WITH hyphens; a
# similarly-named domain without hyphens is a different site with a
# different base URL and auth scheme -- do not use it). Free tier, no card
# needed at signup. Used by odds_client.py / surebet.py.
ODDS_API_KEY=
