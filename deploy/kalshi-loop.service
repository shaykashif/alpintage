[Unit]
Description=Kalshi engine: scanner + Jev prediction loop (paper only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Set to the actual clone path if it differs.
WorkingDirectory=/opt/alpintage
# Relation discovery every ~10 min (plus the cycle itself, ~1-3 min). The
# sports cross-venue model spends Odds API quota, so it stays at every 18
# cycles = ~3 hours.
ExecStart=/opt/alpintage/.venv/bin/python scripts/run_loop.py --interval-min 10 --cross-venue-every 18
Restart=on-failure
RestartSec=30
EnvironmentFile=/opt/alpintage/.env
# Without this, Python buffers stdout when it's not a TTY (always true
# under systemd), so print() output can sit unflushed for a long time --
# journalctl looks silent even when the process is healthy. Confirmed live.
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
